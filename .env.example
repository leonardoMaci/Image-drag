# Copie para .env e ajuste conforme o ambiente.

# Banco de dados.
# SQLite (padrão, local-first — não exige nenhuma infra externa):
DATABASE_URL="file:./dev.db"
# PostgreSQL: troque o provider em prisma/schema.prisma para "postgresql" e use
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/imageboard?schema=public"

# Armazenamento local dos arquivos.
# UPLOAD_DIR é relativo à raiz do projeto e precisa ficar dentro de public/
# para que UPLOAD_PUBLIC_PATH sirva os arquivos.
UPLOAD_DIR="public/uploads"
UPLOAD_PUBLIC_PATH="/uploads"

# Limite de tamanho por upload, em bytes (padrão: 10 MB).
MAX_FILE_SIZE_BYTES="10485760"
